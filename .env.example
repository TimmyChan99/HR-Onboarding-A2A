APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=logs
# Body previews are redacted and capped. Set either value to 0 to disable that side.
LOG_REQUEST_BODY_MAX_BYTES=4000
LOG_RESPONSE_BODY_MAX_BYTES=4000
HOST=0.0.0.0
PORT=8080

# Public URL written in Agent Cards. Use HTTPS outside local development.
PUBLIC_BASE_URL=http://localhost:8080
# URL used by the built-in dispatcher to call this service's A2A endpoints.
INTERNAL_BASE_URL=http://127.0.0.1:8080

# A2A transport authentication. Rotate this and store it in a secret manager.
A2A_API_KEY=replace-with-a-long-random-secret
A2A_API_KEY_HEADER=X-A2A-API-Key

# Langflow WF-01 authenticates to the MCP tool with this separate credential.
MCP_BEARER_TOKEN=replace-with-a-different-long-random-secret
# Langflow executor flows use this to post asynchronous webhook results back.
EXECUTOR_CALLBACK_BEARER_TOKEN=replace-with-a-third-long-random-secret

# Persistent A2A task store. SQLite is suitable for the MVP.
DATABASE_URL=sqlite+aiosqlite:///./data/a2a_tasks.db

# ABA Fusion / Langflow
LANGFLOW_BASE_URL=https://stg-agentic.abafusion.ai
LANGFLOW_API_KEY=replace-with-your-langflow-api-key
# ABA Fusion commonly uses x-api-key. Set Authorization and Bearer<space> when required.
LANGFLOW_API_KEY_HEADER=x-api-key
LANGFLOW_API_KEY_PREFIX=
# Choose one executor transport for all three agents:
# - run_api: the existing /api/v1/run/{flow_id} integration
# - webhook: trigger each Langflow Webhook and wait for its API Request callback
LANGFLOW_EXECUTION_MODE=run_api
# Knowledge can bypass Langflow and run inside this server.
# - langflow: call LANGFLOW_KNOWLEDGE_WEBHOOK_URL and wait for callback
# - internal: use the in-server LangGraph/Gemini/local hybrid RAG agent
KNOWLEDGE_AGENT_MODE=langflow
LANGFLOW_PROFILE_FLOW_ID=replace-with-profile-flow-id-or-alias
LANGFLOW_KNOWLEDGE_FLOW_ID=replace-with-knowledge-flow-id-or-alias
LANGFLOW_PLANNING_FLOW_ID=replace-with-planning-flow-id-or-alias
LANGFLOW_PROFILE_WEBHOOK_URL=
LANGFLOW_KNOWLEDGE_WEBHOOK_URL=
LANGFLOW_PLANNING_WEBHOOK_URL=
LANGFLOW_TIMEOUT_SECONDS=180
LANGFLOW_MAX_ATTEMPTS=3
LANGFLOW_OUTPUT_COMPONENT=
# auto tries the Langflow 1.7-style body, then the newer wrapped body on HTTP 422.
LANGFLOW_API_STYLE=auto
A2A_CLIENT_TIMEOUT_SECONDS=240
# The dispatcher returns TASK_STATE_WORKING after this many seconds while
# long-running agent work continues in the background. Retry the same dispatch
# request to retrieve the cached completed result.
DISPATCH_WAIT_SECONDS=5
DISPATCH_RESULT_TTL_SECONDS=900

# Internal Knowledge Agent. Reads .md, .txt, .json, and .pdf files from docs path.
# Uses local Chroma/BM25 retrieval and Gemini free-tier API when configured.
GOOGLE_API_KEY=
INTERNAL_KNOWLEDGE_MODEL=gemini-2.5-flash
INTERNAL_KNOWLEDGE_DOCS_PATH=knowledge
INTERNAL_KNOWLEDGE_CHROMA_PATH=data/knowledge_chroma
INTERNAL_KNOWLEDGE_CHROMA_COLLECTION=onboarding_knowledge
INTERNAL_KNOWLEDGE_TOP_K=5

# Optional: verify TLS certificates. Keep true in real deployments.
VERIFY_TLS=true
